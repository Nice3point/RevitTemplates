<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!--
    ============================================================
                         Repack Output files

    Targets for repacking the published add-in into a single assembly.
    The build output keeps the original assemblies.
    ============================================================
    -->

    <Target Name="RepackAddinFiles"
            AfterTargets="PublishAddin"
            BeforeTargets="DeployAddin"
            Condition="'$(IsRepackable)' == 'true' AND '$(PublishAddin)' == 'true'">

        <ItemGroup>
            <_ILRepackVersion Include="@(PackageVersion->WithMetadataValue('Identity', 'ILRepack'))"/>
            <_ILRepackVersion Include="@(PackageReference->WithMetadataValue('Identity', 'ILRepack'))" Condition="'@(_ILRepackVersion)' == ''"/>
        </ItemGroup>

        <PropertyGroup>
            <_ILRepackExecutable>$(ILRepack)</_ILRepackExecutable>
            <_ILRepackExecutable Condition="!Exists('$(_ILRepackExecutable)') AND '@(_ILRepackVersion)' != ''">$([MSBuild]::NormalizePath('$(NuGetPackageRoot)', 'ilrepack', '%(_ILRepackVersion.Version)', 'tools', 'ILRepack.exe'))</_ILRepackExecutable>
        </PropertyGroup>

        <Error Condition="!Exists('$(_ILRepackExecutable)')"
               Text="ILRepack is required but not installed. Ensure that ILRepack PackageReference added in your project. If repacking is not needed, disable the IsRepackable property."/>

        <PropertyGroup>
            <_ILRepackHost>$(DOTNET_HOST_PATH)</_ILRepackHost>
            <_ILRepackHost Condition="'$(_ILRepackHost)' == ''">dotnet</_ILRepackHost>
            <_ILRepackPath>&quot;$(_ILRepackExecutable)&quot;</_ILRepackPath>
            <_ILRepackPath Condition="!$([MSBuild]::IsOSPlatform('Windows'))">&quot;$(_ILRepackHost)&quot; $(_ILRepackPath)</_ILRepackPath>
            <_ILRepackDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(AddinPublishDir)', '$(AssemblyName)'))</_ILRepackDirectory>
        </PropertyGroup>

        <ItemGroup>
            <_ILRepackInputNamesExcludes Include="$(RepackBinariesExcludes.Split(';'))"/>
            <_ILRepackInputAssembliesExcludes Include="$(_ILRepackDirectory)%(_ILRepackInputNamesExcludes.Identity)"/>
        </ItemGroup>

        <ItemGroup>
            <_ILRepackInputAssemblies Include="$(_ILRepackDirectory)$(AssemblyName).dll"/>
            <_ILRepackInputAssemblies Include="$(_ILRepackDirectory)*.dll"
                                      Exclude="@(_ILRepackInputAssembliesExcludes);$(_ILRepackDirectory)$(AssemblyName).dll"/>
        </ItemGroup>

        <PropertyGroup>
            <_ILRepackOutputName>$(AssemblyName)</_ILRepackOutputName>
            <_ILRepackOutput>/out:&quot;$(_ILRepackDirectory)$(_ILRepackOutputName).dll&quot;</_ILRepackOutput>
            <_ILRepackInput>@(_ILRepackInputAssemblies -> '&quot;%(FullPath)&quot;', ' ')</_ILRepackInput>
            <_ILRepackLib>@(ReferencePath->'%(RelativeDir)'->Distinct()->'/lib:&quot;%(identity) &quot;', ' ')</_ILRepackLib>
        </PropertyGroup>

        <Message Text="Repacking $(_ILRepackDirectory)$(AssemblyName).dll" Importance="high"/>

        <PropertyGroup>
            <_IsReleaseConfiguration>$(Configuration.ToLowerInvariant().Contains('release'))</_IsReleaseConfiguration>
            <_IsDebugConfiguration Condition="'$(_IsReleaseConfiguration)' != 'true'">true</_IsDebugConfiguration>
        </PropertyGroup>

        <Exec Command="$(_ILRepackPath) /union /illink /parallel $(_ILRepackOutput) $(_ILRepackLib) $(_ILRepackInput)"
              Condition="'$(_IsDebugConfiguration)' == 'true'"/>

        <Exec Command="$(_ILRepackPath) /union /illink /parallel /noRepackRes $(_ILRepackOutput) $(_ILRepackLib) $(_ILRepackInput)"
              StandardOutputImportance="Low"
              Condition="'$(_IsReleaseConfiguration)' == 'true'"/>

        <ItemGroup>
            <_RepackedFiles Include="@(_ILRepackInputAssemblies -> '%(RootDir)%(Directory)%(Filename).dll')" Condition="%(Filename) != $(_ILRepackOutputName)"/>
            <_RepackedFiles Include="@(_ILRepackInputAssemblies -> '%(RootDir)%(Directory)%(Filename).pdb')" Condition="%(Filename) != $(_ILRepackOutputName)"/>
        </ItemGroup>

        <Delete Files="@(_RepackedFiles)"/>
    </Target>

</Project>
